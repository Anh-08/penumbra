{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(*/.venvs/penumbra/bin/python *)",
      "Bash(*/.venvs/penumbra/bin/pytest *)",
      "Bash(npm *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(jq *)",
      "Bash(scripts/board.sh *)",
      "Bash(./scripts/board.sh *)",
      "Bash(scripts/path_guard.py *)",
      "Bash(./scripts/path_guard.py *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm --recursive --force *)",
      "Bash(rm --force --recursive *)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git * push *--force*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(~/**/.env)",
      "Read(~/**/.env.*)",
      "Read(~/**/*.env)"
    ]
  }
}
